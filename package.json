    "check": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "agent",
    "cli",
    "jsonl",
    "trace",
    "tokens"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
