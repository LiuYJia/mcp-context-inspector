{
  "name": "mcp-context-inspector",
  "version": "0.1.0",
  "description": "Local CLI for inspecting MCP and agent trace context, token, and tool-call behavior.",
  "type": "module",
  "bin": {
    "mcp-context-inspector": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
